package org.example.backend;

import org.example.backend.entity.User;
import org.example.backend.repository.IUserRepository;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;

@SpringBootTest
class MongoMappingTest {

    @Autowired
    private IUserRepository userRepository;

    @Test
    void testUserMapping() {
        User user = userRepository.findByEmail("nghia120425@gmail.com").orElse(null);
        System.out.println("TEST_USER_MAPPING: " + (user != null ? "SUCCESS" : "NOT FOUND"));
    }
}
